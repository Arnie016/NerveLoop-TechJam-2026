# Browser/server
HOST=127.0.0.1
PORT=3000
PUBLIC_PORT=3000
# Vite development only. Loopback HTTP origins with an explicit port are
# accepted so a local demo can avoid an occupied API port without proxying data
# to another machine.
LOCAL_API_PROXY_TARGET=http://127.0.0.1:3000
LOG_LEVEL=info
# Required whenever any environment listens beyond loopback. Use 24+ random
# non-placeholder characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Volcengine Ark. ARK_MODEL is an endpoint/model ID that supports the
# OpenAI-compatible Responses API, for example ep-xxxxxxxx.
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=ep-replace-with-your-endpoint-id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Optional host-owned least-cost route selection. It remains off unless every
# constraint and an exact-schema, non-stale catalog are supplied. Prices in the
# current local experiment are synthetic microunits, not provider billing.
MODEL_ROUTING_MODE=off
# MODEL_ROUTING_CATALOG_JSON={"schemaVersion":1,...}
MODEL_ROUTING_MIN_QUALITY_SCORE=800
MODEL_ROUTING_MAX_INPUT_TOKENS=100000
MODEL_ROUTING_MAX_OUTPUT_TOKENS=10000
# MODEL_ROUTING_MAX_COST_MICRO_UNITS=1000
# Optional deployment-lifetime aggregate for accepted routing receipts. Both
# values are required together and MODEL_ROUTING_MODE must be enabled. This is
# synthetic admission accounting, not money, provider quota, or a billing cap.
# Choose an explicit operator-owned expiry; expiration blocks new reservations
# but preserves existing retained minimums for reconciliation.
# MODEL_ROUTING_GLOBAL_BUDGET_MICRO_UNITS=10000
# MODEL_ROUTING_GLOBAL_BUDGET_EXPIRES_AT=2099-01-01T00:00:00.000Z

# Optional deployment-lifetime logical workspace-byte admission. Both limits
# are required when enabled. The scanner counts active, archived, and retained
# quarantine files, but this is not an OS disk/inode quota or tenant boundary.
WORKSPACE_RESOURCE_MODE=off
# WORKSPACE_RESOURCE_MAX_RETAINED_BYTES=1073741824
# WORKSPACE_RESOURCE_MAX_GROWTH_PER_RUN_BYTES=8388608

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
# Opt-in fresh CLI home per Run with bounded history replay; local-process only.
# Shared remains default for existing session resume; containers are not supported.
CODEX_RUN_HOME_MODE=shared
# Experimental CLI capability minimization; requires local-process + run-scoped.
# Not MCP-only: native view_image remains available on the tested CLI.
CODEX_NATIVE_TOOL_POLICY=default
# Opt-in buffered Responses gate; requires reduced-native + local Run-scoped.
# Only reviewed bounded-video-v1 tool names/actions; real-provider compatibility unproven.
CODEX_PROVIDER_GATE=off
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152
# Per-service Run slots, including checkpointing and recovery; integer 1..8.
MAX_CONCURRENT_RUNS=4

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000
